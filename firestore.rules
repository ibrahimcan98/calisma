rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * # ONDER FAMILY - GÜVENLİK KURALLARI
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);

      match /categories/{categoryId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }

      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }

      match /recurringTransactions/{recurringId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }

      match /goals/{goalId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }

      match /subscriptions/{subId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }

      match /students/{studentId} {
        allow get, list: if true; // Public access for reports & login
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);

        match /balanceLogs/{logId} {
          allow get, list: if true;
          allow create: if isOwner(userId);
          allow delete: if isOwner(userId);
        }
        
        match /messages/{messageId} {
          allow get, list: if true;
          allow create, update, delete: if isOwner(userId);
        }
        
        match /checkIns/{checkInId} {
          allow get, list: if true;
          allow create, update, delete: if true; // Students can create check-ins
        }
        
        match /achievements/{achvId} {
          allow get, list: if true;
          allow create, update, delete: if isOwner(userId);
        }
        
        match /vocabularies/{vocabId} {
          allow get, list: if true;
          allow create, update, delete: if isOwner(userId);
        }
      }

      match /lessonLogs/{logId} {
        allow get, list: if true;
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
      }

      // --- PLANLAMA MODÜLÜ KURALLARI ---

      match /events/{eventId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.creatorUserId == userId;
        allow update, delete: if isExistingOwner(userId);
      }

      match /workRules/{ruleId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update, delete: if isExistingOwner(userId);
      }

      match /workLogs/{logId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update, delete: if isExistingOwner(userId);
      }

      match /birthdays/{birthdayId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.creatorUserId == userId;
        allow update, delete: if isExistingOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Allow collectionGroup query for students PIN login
    match /{path=**}/students/{studentId} {
      allow read: if true; 
    }
  }
}
